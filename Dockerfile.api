FROM python:3.12-slim AS base

# Why: Install OS-level build dependencies in a separate layer so they are
# cached and not re-downloaded on every code change.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies before copying source code.
# This layer is cached until requirements.txt changes.
COPY apps/api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy the API source
COPY apps/api/ .
COPY integrations/ ./integrations/
COPY domain/ ./domain/

# Create a non-root user for the running process.
# Why: Running as root inside a container is a security anti-pattern.
RUN useradd -r -u 1001 -g root recoverflow \
    && chown -R recoverflow:root /app
USER recoverflow

# Expose the uvicorn port
EXPOSE 8000

# Healthcheck — Docker will mark the container healthy/unhealthy based on this.
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default command — can be overridden in docker-compose.yml for workers.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
