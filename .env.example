# =============================================================================
# RecoverFlow — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
# Every variable added here must also be documented below.
# =============================================================================

# --- Database ------------------------------------------------------------
# PostgreSQL connection string used by the API and workers.
DATABASE_URL=postgresql+asyncpg://recoverflow:recoverflow@postgres:5432/recoverflow

# Synchronous DSN used by Alembic migrations only.
DATABASE_SYNC_URL=postgresql://recoverflow:recoverflow@postgres:5432/recoverflow

# --- Redis ---------------------------------------------------------------
# Redis connection string used by the task queue and caching layers.
REDIS_URL=redis://redis:6379/0

# --- API -----------------------------------------------------------------
# Secret key for signing internal tokens (generate with: openssl rand -hex 32)
SECRET_KEY=change_me_before_production

# Allowed CORS origins for the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# Environment label: development | staging | production
ENVIRONMENT=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Razorpay (Test Mode) ------------------------------------------------
# Obtain from https://dashboard.razorpay.com → Settings → API Keys → Test Mode
# These are NEVER used directly in business logic; always go via RazorpayProvider.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret_123

# Phase 5: LLM Reasoning
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- LLM -----------------------------------------------------------------
# Provider: openai | anthropic | gemini | mock
# Set to "mock" to run fully offline without any LLM API key.
LLM_PROVIDER=mock
OPENAI_API_KEY=REPLACE_ME_OR_LEAVE_EMPTY_FOR_MOCK
ANTHROPIC_API_KEY=REPLACE_ME_OR_LEAVE_EMPTY_FOR_MOCK
GEMINI_API_KEY=REPLACE_ME_OR_LEAVE_EMPTY_FOR_MOCK

# LLM model name (only used when LLM_PROVIDER != mock)
LLM_MODEL=gpt-4o-mini

# --- Feature Flags -------------------------------------------------------
# Master kill-switch for autonomous actions (true = autonomous allowed).
AUTONOMOUS_ACTIONS_ENABLED=false

# Enable synthetic data seeding on first startup.
SEED_SYNTHETIC_DATA=false

# --- Worker --------------------------------------------------------------
# Number of concurrent workers for the event processing queue.
WORKER_CONCURRENCY=4

# --- Next.js Frontend ----------------------------------------------------
# Public API base URL used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal API URL used by Next.js server components (inside Docker network).
INTERNAL_API_URL=http://api:8000
